    "@bautakt/ui": "workspace:*",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.0.0",
    "electron": "~42.11.18",
    "electron-builder": "^26.0.0",
    "electron-vite": "^6.0.0",
